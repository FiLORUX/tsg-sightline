// File: wrangler.jsonc
// Origin for TSG Sightline: a Worker that serves the repository's static
// assets and enforces origin discipline (see worker/index.js).
//
// The public address is https://tsg.thast.live/sightline/, mounted by the
// tsg-proxy Worker in the thast.se repository. This Worker's own
// *.workers.dev name is an origin, never a surface, so no custom domain is
// bound here on purpose. Deploy with `npx wrangler deploy`.
{
  "name": "tsg-sightline",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-18",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    // The tool lives at the repository root as a single file, so the root
    // is the asset directory; .assetsignore keeps repository furniture out.
    "directory": ".",
    "binding": "ASSETS",
    // Every request passes through the Worker first so the redirect rule
    // applies before any asset is served.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Private venue context (worker/private-context.mjs). The bucket holds one
  // object per shared-link digest with a per-object reader list in its
  // metadata. Both values below identify the Cloudflare Access application on
  // the exact canonical path /sightline/context/*; neither is a credential.
  "r2_buckets": [
    { "binding": "SIGHTLINE_CONTEXTS", "bucket_name": "sightline-contexts" }
  ],
  "durable_objects": { "bindings": [{ "name": "SIGHTLINE_EVENTS", "class_name": "ProjectEvents" }] },
  "migrations": [{ "tag": "project-events-v1", "new_sqlite_classes": ["ProjectEvents"] }],
  "vars": {
    "SIGHTLINE_ACCESS_ISSUER": "https://thast.cloudflareaccess.com",
    "SIGHTLINE_ACCESS_AUD": "2e95db943b83a9ac331870f9b8ce2e110249f2d9c2931958842d88d001031354"
  }
}
